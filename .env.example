DATABASE_URL=postgresql://leadagent:leadagent@postgres:5432/leadagent
# Redis is Celery's broker + result backend and the API session store.
REDIS_URL=redis://redis:6379/0
JWT_SECRET=

# Embeddings (pluggable). Default is OpenAI text-embedding-3-small @ 1536 dims,
# which matches migration 0004 and EMBEDDING_DIM below. Uses OPENAI_API_KEY.
# Switching provider/model to a different vector dimension requires a new
# migration that resizes document_chunks.embedding + a full re-embed.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Only needed if EMBEDDING_PROVIDER=gemini:
EMBEDDING_API_KEY=

# Chat LLM (generation over retrieved chunks). Pluggable provider:
#   LLM_PROVIDER=openai  -> uses OPENAI_API_KEY (default; model gpt-4o-mini)
#   LLM_PROVIDER=gemini  -> uses LLM_API_KEY (or EMBEDDING_API_KEY if blank)
# Leave LLM_MODEL at the sentinel default to let the provider pick its default.
LLM_PROVIDER=openai
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# OpenAI — required for the default chat + embedding providers.
# OPENAI_BASE_URL is optional — set it to target any OpenAI-compatible server.
OPENAI_API_KEY=


# Upload storage. Leave the S3_* values blank for local dev: uploads then go to
# UPLOAD_DIR on disk, which docker-compose shares between the API and the worker
# via the uploads_data volume.
#
# Set them in any deployment where the two run as separate services with their
# own filesystems (Railway, Fly, k8s) — otherwise the worker can't read the file
# the API wrote and ingestion fails with ENOENT. Works with Cloudflare R2, MinIO,
# or AWS S3; for R2 the endpoint is https://<account-id>.r2.cloudflarestorage.com
# and the region must be the literal "auto".
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=uploads/

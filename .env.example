DATABASE_URL=postgresql://leadagent:leadagent@postgres:5432/leadagent
# Redis is Celery's broker + result backend and the API session store.
REDIS_URL=redis://redis:6379/0
JWT_SECRET=

# Embeddings (pluggable). Swap EMBEDDING_PROVIDER to change models — but a
# provider with a different vector dimension requires re-embedding all docs
# and a matching migration (see EMBEDDING_DIM / alembic).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=

# Chat LLM (Gemini generation over retrieved chunks). LLM_API_KEY may be left
# blank to reuse EMBEDDING_API_KEY (same Google API key).
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Production environment — copy to .env.prod and fill in REAL values.
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# The backend runs with ENVIRONMENT=production and REFUSES TO START if JWT_SECRET
# is unset/"change-me" or the DB still uses the default leadagent password.

# --- Domain / TLS ---
# Set to your domain for automatic Let's Encrypt certs; leave as localhost for a
# self-signed demo cert.
DOMAIN=localhost

# --- Database (use a STRONG password; must match DATABASE_URL below) ---
POSTGRES_USER=leadagent
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=leadagent
DATABASE_URL=postgresql://leadagent:CHANGE_ME_strong_db_password@postgres:5432/leadagent

REDIS_URL=redis://redis:6379/0

# --- Auth (generate: `openssl rand -hex 32`) ---
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# --- Origins (must be your HTTPS URL behind Caddy) ---
CORS_ORIGINS=https://localhost
FRONTEND_BASE_URL=https://localhost

# --- Concurrency ---
WEB_CONCURRENCY=4

# --- LLM / embeddings (fill in real keys) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
OPENAI_API_KEY=

# --- Email (optional; blank = reset links logged instead of sent) ---
RESEND_API_KEY=
EMAIL_FROM=LeadLoop <onboarding@resend.dev>
